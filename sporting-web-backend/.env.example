# Server Port & Environment
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=sporting_db

# JWT Authentication Config
JWT_SECRET=your_super_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Mailer Configuration (Nodemailer / Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password
MAIL_FROM=Sporting ONE <no-reply@sportingone.vn>

# System & Booking Configuration
UNPAID_BOOKING_TIMEOUT_MINUTES=10

# OpenRouteService API Config (Maps & Routing)
ORS_API_KEY=your_openrouteservice_api_key_here

# PayOS Payment Gateway Configuration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Google Gemini AI Configuration
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
GEMINI_API_KEYS=AIzaSy_key1,AIzaSy_key2,AIzaSy_key3
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Google Drive Cloud Storage (Avatar / Media Upload)
GOOGLE_DRIVE_CREDENTIAL_PATH=src/credential/service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id
GOOGLE_DRIVE_AVATAR_FOLDER_NAME=avatar-user
GOOGLE_DRIVE_BACKUP_FOLDER_NAME=sporting-backups
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_drive_refresh_token

# Automated Backup Schedule (Google Drive + ZIP)
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_TIME=4:00
BACKUP_SCHEDULE_CRON="0 4 * * *"
BACKUP_SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh

# Frontend Vite Configuration
VITE_API_BASE_URL=https://api.sportingone.site/api/v1
VITE_DEFAULT_SEARCH_RADIUS_KM=3
VITE_USER_ACTIVITY_THROTTLE_MS=10000

# Support & Contact Information
VITE_SUPPORT_EMAIL=vuhieu27082002@gmail.com
VITE_SUPPORT_PHONE=0934975292
VITE_SUPPORT_PHONE_DISPLAY="+84 93 497 5292"
VITE_SUPPORT_ADDRESS="K596 Hoàng Diệu, Đà Nẵng"
SUPPORT_EMAIL=vuhieu27082002@gmail.com
SUPPORT_PHONE=0934975292

# AI Chatbox Configuration
CHAT_MESSAGES_LIMIT=5
CHAT_CONVERSATIONS_LIMIT=5
